# Copy to .env or export these before running.
# Paths assume you run from SEER/code/  (with SEER/data/ and SEER/hfcache/ beside it).

# HuggingFace token (optional, only if models require auth)
export HF_TOKEN=hf_xxx

# Path to your BIRD-SQL dataset (auto-detects nested folders inside)
export BIRD_ROOT=../data

# Where to write experiment results (detail JSON, summary JSON, calibration cache)
export SEER_RESULTS=./results

# Where to cache downloaded models (keeps the ~14 GB out of your home dir)
export HF_HOME=../hfcache
