# Copy to .env, or export these before running. Paths are relative to the repo root.

# HuggingFace token (optional, only if the models require auth)
export HF_TOKEN=hf_xxx

# Unzipped BIRD-SQL release (nested layouts are auto-detected)
export BIRD_ROOT=./bird

# Where experiment results are written
export SEER_RESULTS=./results

# Model cache (keeps the ~14 GB out of your home dir)
export HF_HOME=./hfcache
